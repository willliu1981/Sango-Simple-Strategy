<ui xmlns="http://kuan.studio/simpleui">
    <table id="main" i18n="literal" flags="fillParent" pad="30"
        backgroundColor="0.010,0.009,0.008,0.74">
        <table width="1810" height="1010" pad="32" backgroundColor="0.040,0.032,0.027,0.98">
            <label fontKey="title" fontSize="68" width="1700" height="82" color="0.94,0.76,0.43,1">${text:new_game_title}</label>
            <row />
            <label id="new_game_status_label" fontSize="27" width="1700" height="44" color="0.77,0.70,0.59,1">${text:new_game_status_ready}</label>
            <row />
            <table width="1700" height="655" padTop="8">
                <table width="600" height="645" pad="28" backgroundColor="0.070,0.057,0.047,0.98">
                    <label fontKey="title" fontSize="48" width="530" height="60" color="0.90,0.72,0.40,1">${text:new_game_scenario_heading}</label>
                    <row />
                    <table width="530" height="62">
                        <textButton id="scenario_china_button" fontSize="25" width="250" height="56">${text:scenario_china_short}</textButton>
                        <textButton id="scenario_world_button" fontSize="25" width="250" height="56" padLeft="16">${text:scenario_world_short}</textButton>
                    </table>
                    <row />
                    <label id="scenario_name_label" fontSize="34" width="530" height="62" wrap="true">${text:scenario_china_name}</label>
                    <row />
                    <label id="scenario_description_label" fontSize="24" width="530" height="115"
                        align="left" textAlign="left" wrap="true" color="0.76,0.70,0.61,1">${text:scenario_china_description}</label>
                    <row />
                    <label fontKey="title" fontSize="34" width="530" height="50" color="0.88,0.70,0.39,1">${text:new_game_save_slot_heading}</label>
                    <row />
                    <textButton id="new_game_slot_1_button" fontSize="28" width="520" height="66">${text:new_game_slot_1_placeholder}</textButton>
                    <row />
                    <textButton id="new_game_slot_2_button" fontSize="28" width="520" height="66" padTop="10">${text:new_game_slot_2_placeholder}</textButton>
                    <row />
                    <textButton id="new_game_slot_3_button" fontSize="28" width="520" height="66" padTop="10">${text:new_game_slot_3_placeholder}</textButton>
                    <row />
                    <label id="selected_slot_label" fontSize="24" width="530" height="42" color="0.74,0.68,0.58,1">${text:new_game_selected_slot_placeholder}</label>
                </table>
                <table width="34"></table>
                <table width="1035" height="645" pad="28" backgroundColor="0.060,0.049,0.041,0.98">
                    <label fontKey="title" fontSize="48" width="950" height="60" color="0.90,0.72,0.40,1">${text:new_game_faction_heading}</label>
                    <row />
                    <table width="940" height="80">
                        <textButton id="faction_1_button" fontSize="32" width="295" height="74">${text:faction_cao_cao}</textButton>
                        <textButton id="faction_2_button" fontSize="32" width="295" height="74" padLeft="18">${text:faction_liu_bei}</textButton>
                        <textButton id="faction_3_button" fontSize="32" width="295" height="74" padLeft="18">${text:faction_sun_ce}</textButton>
                    </table>
                    <row />
                    <table width="940" height="80">
                        <textButton id="faction_4_button" fontSize="32" width="295" height="74">${text:faction_yuan_shao}</textButton>
                        <textButton id="faction_5_button" fontSize="32" width="295" height="74" padLeft="18">${text:faction_liu_biao}</textButton>
                        <textButton id="faction_6_button" fontSize="32" width="295" height="74" padLeft="18">${text:faction_ma_teng}</textButton>
                    </table>
                    <row />
                    <table width="940" height="355" pad="20" backgroundColor="0.040,0.034,0.030,1">
                        <label id="selected_faction_label" fontSize="33" width="870" height="44" align="left" textAlign="left">${text:new_game_selected_faction_placeholder}</label>
                        <row />
                        <label id="selected_ruler_label" fontSize="29" width="870" height="38" align="left" textAlign="left">${text:new_game_selected_ruler_placeholder}</label>
                        <row />
                        <label id="selected_city_label" fontSize="29" width="870" height="38" align="left" textAlign="left">${text:new_game_selected_city_placeholder}</label>
                        <row />
                        <label id="selected_resources_label" fontSize="29" width="870" height="46" align="left" textAlign="left">${text:new_game_selected_resources_placeholder}</label>
                        <row />
                        <label id="selected_summary_label" fontSize="27" width="870" height="126" align="left" textAlign="left"
                            wrap="true" color="0.72,0.66,0.57,1">${text:new_game_selected_summary_placeholder}</label>
                    </table>
                </table>
            </table>
            <row />
            <table width="1700" height="88" padTop="12">
                <textButton id="new_game_back_button" fontSize="36" width="520" height="82">${text:button_back_lobby}</textButton>
                <table width="520"></table>
                <textButton id="start_game_button" fontSize="36" width="620" height="82">${text:button_start_game}</textButton>
            </table>
        </table>
    </table>

    <table id="overwrite_mask" i18n="literal" visible="false" touchable="enabled"
        backgroundColor="0,0,0,0.88" flags="fillParent">
        <table width="940" pad="54" backgroundColor="0.055,0.043,0.035,0.995">
            <label fontKey="title" fontSize="62" width="810" height="88" color="0.94,0.76,0.43,1">${text:overwrite_title}</label>
            <row />
            <label id="overwrite_description_label" fontSize="32" width="800" height="125" wrap="true"
                color="0.84,0.80,0.72,1">${text:overwrite_description}</label>
            <row />
            <table width="800" height="88" padTop="26">
                <textButton id="overwrite_cancel_button" fontSize="36" width="360" height="82">${text:button_cancel}</textButton>
                <textButton id="overwrite_confirm_button" fontSize="36" width="410" height="82" padLeft="30">${text:button_overwrite}</textButton>
            </table>
        </table>
    </table>
</ui>
