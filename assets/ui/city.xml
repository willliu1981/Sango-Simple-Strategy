<ui xmlns="http://kuan.studio/simpleui">
    <table id="main" i18n="literal" flags="fillParent" pad="26"
        backgroundColor="0.010,0.009,0.008,0.76">
        <table width="1840" height="1010" pad="26" backgroundColor="0.040,0.032,0.027,0.98">
            <table width="1780" height="94">
                <label fontKey="title" fontSize="58" width="430" height="82" align="left"
                    textAlign="left" color="0.94,0.76,0.43,1">${text:city_title}</label>
                <table width="760" height="90">
                    <label id="scenario_label" fontSize="27" width="730" height="42"
                        align="left" textAlign="left">${text:city_scenario_placeholder}</label>
                    <row />
                    <label id="date_label" fontSize="27" width="730" height="42"
                        align="left" textAlign="left" color="0.72,0.66,0.56,1">${text:city_date_placeholder}</label>
                </table>
                <table width="560" height="90">
                    <label id="turn_label" fontSize="23" width="540" height="26"
                        align="right" textAlign="right">${text:city_turn_placeholder}</label>
                    <row />
                    <label id="action_points_label" fontSize="28" width="540" height="32"
                        align="right" textAlign="right" color="0.94,0.76,0.38,1">${text:city_action_points_placeholder}</label>
                    <row />
                    <label id="national_order_label" fontSize="20" width="540" height="28"
                        align="right" textAlign="right" color="0.73,0.78,0.69,1">${text:national_order_placeholder}</label>
                </table>
            </table>
            <row />

            <table width="1780" height="710" padTop="10">
                <table width="650" height="700" pad="22" backgroundColor="0.065,0.053,0.044,0.98">
                    <label id="city_name_heading_label" fontKey="title" fontSize="48" width="590" height="58"
                        color="0.90,0.72,0.40,1">${text:city_overview_heading}</label>
                    <row />
                    <label id="faction_label" fontSize="26" width="590" height="36"
                        align="left" textAlign="left">${text:city_faction_placeholder}</label>
                    <row />
                    <label id="ruler_label" fontSize="26" width="590" height="36"
                        align="left" textAlign="left">${text:city_ruler_placeholder}</label>
                    <row />
                    <scrollPane id="city_overview_scroll" width="600" height="480"
                        flags="scrollingDisableX,hideScrollbars">
                    <table width="590">
                    <table width="590" height="370" pad="16" backgroundColor="0.040,0.034,0.030,1">
                        <table width="180">
                            <label fontSize="23" width="165" height="27" align="left" textAlign="left">${text:stat_gold}</label>
                            <row /><label id="gold_value_label" fontSize="28" width="165" height="33" align="left" textAlign="left" color="0.94,0.78,0.44,1">0</label>
                            <row /><label fontSize="23" width="165" height="27" align="left" textAlign="left">${text:stat_population}</label>
                            <row /><label id="population_value_label" fontSize="28" width="165" height="33" align="left" textAlign="left">0</label>
                            <row /><label fontSize="23" width="165" height="27" align="left" textAlign="left">${text:stat_agriculture}</label>
                            <row /><label id="agriculture_value_label" fontSize="28" width="165" height="33" align="left" textAlign="left" color="0.80,0.84,0.58,1">0 / 100</label>
                            <row /><label fontSize="23" width="165" height="27" align="left" textAlign="left">${text:stat_water_control}</label>
                            <row /><label id="water_control_value_label" fontSize="28" width="165" height="33" align="left" textAlign="left" color="0.58,0.78,0.88,1">0 / 100</label>
                        </table>
                        <table width="180">
                            <label fontSize="23" width="165" height="27" align="left" textAlign="left">${text:stat_food}</label>
                            <row /><label id="food_value_label" fontSize="28" width="165" height="33" align="left" textAlign="left" color="0.82,0.86,0.55,1">0</label>
                            <row /><label fontSize="23" width="165" height="27" align="left" textAlign="left">${text:stat_troops}</label>
                            <row /><label id="troops_value_label" fontSize="28" width="165" height="33" align="left" textAlign="left" color="0.88,0.67,0.54,1">0</label>
                            <row /><label fontSize="23" width="165" height="27" align="left" textAlign="left">${text:stat_commerce}</label>
                            <row /><label id="commerce_value_label" fontSize="28" width="165" height="33" align="left" textAlign="left" color="0.72,0.76,0.88,1">0 / 100</label>
                            <row /><label fontSize="23" width="165" height="27" align="left" textAlign="left">${text:stat_defense}</label>
                            <row /><label id="defense_value_label" fontSize="28" width="165" height="33" align="left" textAlign="left" color="0.86,0.68,0.54,1">0 / 100</label>
                        </table>
                        <table width="180">
                            <label fontSize="23" width="165" height="27" align="left" textAlign="left">${text:stat_public_order}</label>
                            <row /><label id="public_order_value_label" fontSize="28" width="165" height="33" align="left" textAlign="left" color="0.72,0.84,0.80,1">0 / 100</label>
                            <row /><label fontSize="23" width="165" height="27" align="left" textAlign="left">${text:stat_training}</label>
                            <row /><label id="training_value_label" fontSize="28" width="165" height="33" align="left" textAlign="left" color="0.88,0.72,0.58,1">0 / 100</label>
                            <row /><label fontSize="23" width="165" height="27" align="left" textAlign="left">${text:stat_morale}</label>
                            <row /><label id="morale_value_label" fontSize="28" width="165" height="33" align="left" textAlign="left" color="0.90,0.73,0.48,1">0 / 100</label>
                            <row /><label fontSize="23" width="165" height="27" align="left" textAlign="left">${text:stat_quarterly_tax}</label>
                            <row /><label id="tax_estimate_value_label" fontSize="28" width="165" height="33" align="left" textAlign="left" color="0.94,0.78,0.44,1">0</label>
                            <row /><label fontSize="23" width="165" height="27" align="left" textAlign="left">${text:stat_harvest}</label>
                            <row /><label id="harvest_estimate_value_label" fontSize="28" width="165" height="33" align="left" textAlign="left" color="0.82,0.86,0.55,1">0</label>
                        </table>
                    </table>
                    <row />
                    <label id="public_order_recovery_label" fontSize="21" width="590" height="34"
                        align="left" textAlign="left" color="0.72,0.84,0.80,1">${text:city_public_order_recovery_placeholder}</label>
                    <row />
                    <label id="season_forecast_label" fontSize="22" width="590" height="72"
                        align="left" textAlign="left" wrap="true" color="0.73,0.68,0.58,1">${text:city_season_forecast_placeholder}</label>
                    <row />
                    <label id="population_projection_label" fontSize="22" width="590" height="64"
                        align="left" textAlign="left" wrap="true" color="0.73,0.78,0.66,1">${text:population_projection_placeholder}</label>
                    </table>
                    </scrollPane>
                </table>

                <table width="30"></table>

                <table width="1100" height="700" pad="22" backgroundColor="0.057,0.047,0.040,0.98">
                    <label fontKey="title" fontSize="48" width="1040" height="58"
                        color="0.90,0.72,0.40,1">${text:city_actions_heading}</label>
                    <row />
                    <label fontSize="25" width="1020" height="58" wrap="true"
                        color="0.70,0.65,0.56,1">${text:city_actions_note}</label>
                    <row />
                    <label id="city_faction_resources_label" fontSize="25" width="1020" height="36"
                        align="left" textAlign="left" color="0.94,0.78,0.44,1">${text:city_faction_resources_placeholder}</label>
                    <row />
                    <table width="1020" height="390" padTop="8">
                        <textButton id="agriculture_button" fontSize="29" width="485" height="82">${text:button_agriculture}</textButton>
                        <textButton id="commerce_button" fontSize="29" width="485" height="82" padLeft="24">${text:button_commerce}</textButton>
                        <row />
                        <textButton id="water_control_button" fontSize="29" width="485" height="82" padTop="12">${text:button_water_control}</textButton>
                        <textButton id="fortify_button" fontSize="29" width="485" height="82" padLeft="24" padTop="12">${text:button_fortify}</textButton>
                        <row />
                        <textButton id="recruit_button" fontSize="29" width="485" height="82" padTop="12">${text:button_recruit}</textButton>
                        <textButton id="train_button" fontSize="29" width="485" height="82" padLeft="24" padTop="12">${text:button_train}</textButton>
                        <row />
                        <textButton id="pacify_button" fontSize="29" width="485" height="82" padTop="12">${text:button_pacify_short}</textButton>
                    </table>
                    <row />
                    <label fontSize="24" width="1020" height="112" align="left" textAlign="left"
                        wrap="true" color="0.68,0.62,0.53,1">${text:city_rule_summary}</label>
                </table>
            </table>
            <row />

            <label id="city_status_label" fontSize="26" width="1780" height="64"
                wrap="true" color="0.79,0.72,0.61,1">${text:city_status_ready}</label>
            <row />
            <table width="1780" height="88" padTop="8">
                <textButton id="city_settings_button" fontSize="34" width="300" height="80">${text:button_settings}</textButton>
                <textButton id="city_context_help_button" fontSize="32" width="280" height="80" padLeft="20">操作說明</textButton>
                <textButton id="return_map_button" fontSize="34" width="430" height="80" padLeft="20">${text:button_return_map}</textButton>
                <table width="190"></table>
                <textButton id="city_end_month_button" fontSize="36" width="520" height="80">${text:button_end_month}</textButton>
            </table>
        </table>
    </table>

    <table id="city_end_month_mask" i18n="literal" visible="false" touchable="enabled"
        backgroundColor="0,0,0,0.88" flags="fillParent">
        <table width="1040" pad="52" backgroundColor="0.055,0.043,0.035,0.995">
            <label id="city_end_month_title_label" fontKey="title" fontSize="60" width="900" height="86"
                color="0.94,0.76,0.43,1">${text:end_month_confirm_title_placeholder}</label>
            <row />
            <label id="city_end_month_description_label" fontSize="31" width="890" height="150"
                wrap="true" color="0.84,0.80,0.72,1">${text:end_month_confirm_description_placeholder}</label>
            <row />
            <table width="890" height="86" padTop="24">
                <textButton id="city_end_month_cancel_button" fontSize="36" width="400" height="82">${text:button_cancel}</textButton>
                <textButton id="city_end_month_confirm_button" fontSize="36" width="460" height="82"
                    padLeft="30">${text:button_end_month_confirm}</textButton>
            </table>
        </table>
    </table>

    <table id="city_battle_prompt_mask" i18n="literal" visible="false" touchable="enabled"
        backgroundColor="0,0,0,0.88" flags="fillParent">
        <table width="1040" pad="52" backgroundColor="0.060,0.038,0.030,0.995">
            <label id="city_battle_prompt_title_label" fontKey="title" fontSize="60" width="900" height="86"
                color="0.96,0.53,0.35,1">${text:battle_prompt_title_placeholder}</label>
            <row />
            <label id="city_battle_prompt_description_label" fontSize="31" width="890" height="125"
                wrap="true" color="0.86,0.80,0.70,1">${text:battle_prompt_description}</label>
            <row />
            <table width="890" height="86" padTop="24">
                <textButton id="city_battle_prompt_later_button" fontSize="36" width="400" height="82">${text:button_view_later}</textButton>
                <textButton id="city_battle_prompt_view_button" fontSize="36" width="460" height="82"
                    padLeft="30">${text:button_view_battle_report}</textButton>
            </table>
        </table>
    </table>

    <table id="recruitment_mask" i18n="literal" visible="false" touchable="enabled"
        backgroundColor="0,0,0,0.90" flags="fillParent">
        <table width="1320" pad="44" backgroundColor="0.055,0.043,0.035,0.995">
            <label id="recruitment_title_label" fontKey="title" fontSize="56" width="1210" height="78"
                color="0.94,0.76,0.43,1">${text:recruitment_title}</label>
            <row />
            <label fontSize="25" width="1200" height="66" wrap="true" color="0.80,0.74,0.63,1">${text:recruitment_description}</label>
            <row />
            <label id="recruitment_limit_label" fontSize="26" width="1200" height="66" wrap="true">${text:recruitment_placeholder}</label>
            <row />
            <label id="recruitment_order_label" fontSize="25" width="1200" height="72" wrap="true"
                color="0.74,0.80,0.68,1">${text:recruitment_placeholder}</label>
            <row />
            <table width="1200" height="88" padTop="8">
                <textButton id="recruitment_min_button" fontSize="28" width="180" height="76">${text:recruitment_min}</textButton>
                <textButton id="recruitment_minus_button" fontSize="30" width="180" height="76" padLeft="16">${text:recruitment_minus}</textButton>
                <textField id="recruitment_amount_input" fontSize="38" width="355" height="76" padLeft="16" text="200" />
                <textButton id="recruitment_plus_button" fontSize="30" width="180" height="76" padLeft="16">${text:recruitment_plus}</textButton>
                <textButton id="recruitment_max_button" fontSize="28" width="180" height="76" padLeft="16">${text:recruitment_max}</textButton>
            </table>
            <row />
            <table id="recruitment_slider_host" width="1190" height="76" padTop="8"></table>
            <row />
            <label id="recruitment_preview_label" fontSize="31" width="1190" height="160" wrap="true"
                align="left" textAlign="left" color="0.94,0.81,0.53,1">${text:recruitment_placeholder}</label>
            <row />
            <label id="recruitment_status_label" fontSize="25" width="1190" height="60" wrap="true"
                color="0.85,0.73,0.64,1">${text:recruitment_ready}</label>
            <row />
            <table width="1190" height="94" padTop="12">
                <textButton id="recruitment_help_button" fontSize="31" width="250" height="80">徵兵說明</textButton>
                <textButton id="recruitment_cancel_button" fontSize="34" width="400" height="80" padLeft="20">${text:button_cancel}</textButton>
                <textButton id="recruitment_confirm_button" fontSize="34" width="480" height="80" padLeft="20">${text:recruitment_confirm}</textButton>
            </table>
        </table>
    </table>
</ui>
